# Local configuration template only. Never commit real credentials.
#
# Frontend: copy this file to .env in the repository root.
REACT_APP_BASE_URL=http://localhost:4001/api/v1

# Backend: copy this file to server/.env.
MONGODB_URL=mongodb://127.0.0.1:27017/edunest
JWT_SECRET=replace-with-a-local-development-secret
PORT=4000

# Optional backend AI provider. Leave OPENAI_API_KEY empty for lexical
# retrieval and source-preview mode.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
AI_TOP_K=5
AI_MAX_UPLOAD_BYTES=10485760
AI_SEMANTIC_THRESHOLD=0.2
AI_LEX_THRESHOLD=0.1

# Existing LMS backend provider placeholders
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=
RAZORPAY_KEY=
RAZORPAY_SECRET=
MAIL_HOST=
MAIL_USER=
MAIL_PASS=
