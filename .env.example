# EduNest AI configuration template. Never commit real credentials.
# Copy this file to server/.env for local backend development. The React app
# needs no root .env unless REACT_APP_BASE_URL is intentionally overridden.

# Runtime
NODE_ENV=development
PORT=4000

# Persistent MongoDB-compatible database. Required in production.
MONGODB_URL=mongodb://127.0.0.1:27017/edunest
JWT_SECRET=<replace-with-a-long-random-secret>

# Public application origin only (no path or trailing slash).
CLIENT_URL=http://localhost:3000

# Optional Google OpenID Connect Authorization Code flow. The redirect URI must
# exactly match an Authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=<google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Optional OpenAI-backed embeddings and grounded generation. Leave the key
# empty to keep lexical retrieval, source preview, and deterministic quizzes.
OPENAI_API_KEY=<openai-api-key>
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
AI_TOP_K=5
AI_MAX_UPLOAD_BYTES=10485760
AI_SEMANTIC_THRESHOLD=0.2
AI_LEX_THRESHOLD=0.1

# Optional Razorpay payments
RAZORPAY_KEY=<razorpay-key>
RAZORPAY_SECRET=<razorpay-secret>

# Optional email delivery
MAIL_HOST=<smtp-host>
MAIL_USER=<smtp-user>
MAIL_PASS=<smtp-password>

# Optional Cloudinary-backed persistent course media
CLOUD_NAME=<cloudinary-cloud-name>
API_KEY=<cloudinary-api-key>
API_SECRET=<cloudinary-api-secret>
FOLDER_NAME=edunest-prod

# Azure App Service examples (set these as application settings, not here):
# NODE_ENV=production
# CLIENT_URL=https://<app-name>.azurewebsites.net
# GOOGLE_REDIRECT_URI=https://<app-name>.azurewebsites.net/api/v1/auth/google/callback
# In production, do not set REACT_APP_BASE_URL; the compiled client uses /api/v1.
