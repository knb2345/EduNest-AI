# Local configuration template only. Never commit real credentials.
#
# Frontend: copy this file to .env in the repository root.
REACT_APP_BASE_URL=http://localhost:4000/api/v1

# Backend: copy this file to server/.env.
MONGODB_URL=mongodb://127.0.0.1:27017/edunest
JWT_SECRET=replace-with-a-local-development-secret
PORT=4000
CLIENT_URL=http://localhost:3000

# Optional Google login (OpenID Connect Authorization Code flow). Set only in
# server/.env. The redirect URI must exactly match the Google Cloud Console entry.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# Optional backend AI provider. Set only in server/.env. Leave empty for
# lexical retrieval and source-preview mode.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
AI_TOP_K=5
AI_MAX_UPLOAD_BYTES=10485760
AI_SEMANTIC_THRESHOLD=0.2
AI_LEX_THRESHOLD=0.1

# Optional media, payment, and email providers
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=
RAZORPAY_KEY=
RAZORPAY_SECRET=
MAIL_HOST=
MAIL_USER=
MAIL_PASS=
